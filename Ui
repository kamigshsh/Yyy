local content = make("Frame", {
	Position = UDim2.fromOffset(9, 96),
	Size = UDim2.fromOffset(622, 440),
	BackgroundTransparency = 1,
}, main)

local buttons, current = {}, 1

local function open(n)
	current = n
	for i, b in ipairs(buttons) do
		local on = i == n
		b.btn.BackgroundColor3 = on and col.tabOn or col.tab
		b.btn.TextColor3 = on and col.accent or col.dim
		b.line.Color = on and col.tabLineOn or col.tabLine
	end
	content:ClearAllChildren()
	for i, p in ipairs(tabs[n].panels) do
		newPanel(content, p, (i - 1) % 2, (i - 1) // 2)
	end
end

for i, t in ipairs(tabs) do
	local b = make("TextButton", {
		Position = UDim2.fromScale((i - 1) / #tabs, 0),
		Size = UDim2.fromScale(1 / #tabs, 1),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = t.name,
		Font = font,
		TextSize = fsize,
	}, tabBar)
	buttons[i] = { btn = b, line = outline(b, col.tabLine) }

	b.MouseButton1Click:Connect(function() open(i) end)
	b.MouseEnter:Connect(function()
		if current ~= i then b.TextColor3 = col.text end
	end)
	b.MouseLeave:Connect(function()
		if current ~= i then b.TextColor3 = col.dim end
	end)
end

