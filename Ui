-- widgets
local function newToggle(parent, item)
	local row = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, parent)
	local box = make("Frame", {
		Position = UDim2.fromOffset(0, 5),
		Size = UDim2.fromOffset(12, 12),
		BorderSizePixel = 0,
	}, row)
	local line = outline(box, col.boxLine)
	local fill = shade(box, col.fillA, col.fillB)
	local txt = label(row, item[1], UDim2.fromOffset(22, 0), UDim2.new(1, -22, 1, 0))

	local function draw()
		local on = item[2]
		fill.Enabled = on
		box.BackgroundColor3 = on and Color3.new(1, 1, 1) or col.box
		line.Color = on and Color3.fromRGB(160, 168, 182) or col.boxLine
		txt.TextColor3 = on and col.text or col.off
	end
	draw()

	row.MouseButton1Click:Connect(function()
		item[2] = not item[2]
		draw()
	end)
end

local sliding
UIS.InputChanged:Connect(function(i)
	if sliding and isMove(i) then sliding(i.Position.X) end
end)
UIS.InputEnded:Connect(function(i)
	if isPress(i) then sliding = nil end
end)

local function newSlider(parent, item)
	local holder = make("Frame", { Size = UDim2.new(1, 0, 0, 37), BackgroundTransparency = 1 }, parent)
	label(holder, item[1], UDim2.new(), UDim2.new(1, 0, 0, 16), col.dim)

	local bar = make("TextButton", {
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 15),
		BackgroundColor3 = col.box,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	}, holder)
	outline(bar, col.boxLine)

	local fill = make("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, bar)
	shade(fill, col.fillA, col.fillB)

	local val = label(bar, "", UDim2.new(), UDim2.fromScale(1, 1), col.text, Enum.TextXAlignment.Center)
	val.ZIndex = 3

	local function set(v)
		v = math.clamp(math.round(v * 100) / 100, 0, 1)
		item[2] = v
		fill.Size = UDim2.fromScale(v, 1)
		val.Text = string.format("%.2f", v)
	end
	set(item[2])

	local function fromX(x)
		set((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
	end

	bar.InputBegan:Connect(function(i)
		if isPress(i) then
			sliding = fromX
			fromX(i.Position.X)
		end
	end)
end

local function newPanel(parent, data, cx, cy)
	local p = make("Frame", {
		Position = UDim2.fromOffset(cx * 316, cy * 225),
		Size = UDim2.fromOffset(306, 215),
		BackgroundColor3 = col.panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, parent)
	outline(p, col.panelLine)

	local top = make("Frame", {
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Color3.fromRGB(225, 232, 242),
		BorderSizePixel = 0,
	}, p)
	make("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, top)

	label(p, data.title, UDim2.fromOffset(9, 8), UDim2.new(1, -18, 0, 16))

	local list = make("Frame", {
		Position = UDim2.fromOffset(9, 28),
		Size = UDim2.new(1, -18, 1, -34),
		BackgroundTransparency = 1,
	}, p)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)

	for _, t in ipairs(data.toggles) do newToggle(list, t) end
	for _, s in ipairs(data.sliders) do newSlider(list, s) end
end

